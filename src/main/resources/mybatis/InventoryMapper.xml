<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.integratedbookinfo.system.inventory.InventoryMapper">

	<!-- 在庫 論理削除 -->
	<update id="deleteInventoryByBookId" parameterType="String">
	
		UPDATE
			t_inventories
		SET
			deleted_flag = 1
		WHERE
			book_id = #{bookId}
	
	</update>
	
</mapper>